//@version=6
indicator("HMA", overlay = true)

src = input.source(close, "Source")

len1 = input.int(10, title = "HMA 1 Length", minval = 1)
len2 = input.int(20, title = "HMA 2 Length", minval = 1)

hma1 = ta.hma(src, len1)
hma2 = ta.hma(src, len2)

hma1Up   = hma1 > hma1[1]
hma2Up   = hma2 > hma2[1]

hma1Color = hma1Up ? color.green : color.red
hma2Color = hma2Up ? color.green : color.red

plot(hma1, title = "HMA 1", color = hma1Color, linewidth = 2, linestyle = plot.linestyle_dashed)
plot(hma2, title = "HMA 2", color = hma2Color, linewidth = 2, linestyle = plot.linestyle_dashed)

plotshape(
        ta.crossover(hma1, hma2),
        style = shape.triangleup,
        location = location.bottom,
        color = color.green
)
plotshape(
        ta.crossunder(hma1, hma2),
        style = shape.triangledown,
        location = location.bottom,
        color = color.red
)
