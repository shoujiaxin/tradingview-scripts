//@version=6
strategy("SPY Intraday Noise Momentum", shorttitle = "Noise Momentum", overlay = true, pyramiding = 0,
     initial_capital = 1000000, margin_long = 0, margin_short = 0,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.0045,
     slippage = 0, calc_on_every_tick = false, calc_on_order_fills = false,
     process_orders_on_close = true)

// Intraday momentum after Zarattini, Aziz & Barbon (2024), "Beat the Market: An Effective Intraday Momentum Strategy
// for S&P500 ETF (SPY)", plus a filter on the previous session's move.
//
// Signals: every 30 minutes from the open until 30 minutes before the close, go long when the close is above both the
// upper bound and the session VWAP, short when it is below both the lower bound and the VWAP, and flat otherwise.
// Bounds: max(open, previous close) x (1 + width) and min(open, previous close) x (1 - width). The width at a check is
// the mean absolute move from the open at that time of day over the last 14 sessions; the previous close is reduced by
// a dividend going ex today. A new position on one side is skipped, leaving the book flat, when the previous session
// returned at least one daily volatility in that direction. Every position closes one minute before the close, on the
// close of the bar ending at 15:59 (12:59 on 13:00 early closes).
// Size: shares are fixed at the open to floor(equity x min(4, 2% / daily volatility) / open), where the daily
// volatility is the sample standard deviation of the last 14 close-to-close returns.
//
// Use a 1-minute chart with regular trading hours. Orders fill at the close of the bar that triggers them. The default
// commission of 0.0045 per share also covers slippage. History comes from 30-minute and daily bars read one bar late,
// so signals use completed bars only and do not repaint. The exception is a live ex-date: the previous close is
// adjusted only if TradingView reports the dividend by the open.

// ————— Inputs
int lookbackInput = input.int(14, "Band Lookback (Sessions)", minval = 1, group = "Noise Band")
float bandMultInput = input.float(1.0, "Band Width Multiplier", minval = 0.0, step = 0.1, group = "Noise Band")
int volWindowInput = input.int(14, "Volatility Window (Sessions)", minval = 2, group = "Sizing")
float targetVolInput = input.float(2.0, "Daily Volatility Target (%)", minval = 0.01, step = 0.1, group = "Sizing") / 100.0
float maxLeverageInput = input.float(4.0, "Max Leverage", minval = 0.01, step = 0.5, group = "Sizing")
bool priorMoveFilterInput = input.bool(true, "Skip Entries After a Large Prior Move", group = "Prior-Move Filter")
float priorMoveMaxInput = input.float(1.0, "Prior Move Threshold (Daily Volatilities)", minval = 0.0, step = 0.1, group = "Prior-Move Filter")

if not timeframe.isminutes or timeframe.multiplier != 1
    runtime.error("Use a 1-minute chart: the rules act on 1-minute bars.")
if syminfo.session != session.regular
    runtime.error("Turn off extended trading hours: the rules use regular-session bars only.")

// ————— Constants
const int CHECK_EVERY = 30      // minutes between checks, counted from the open
const int LAST_CHECK_GAP = 30   // the last check comes at least this many minutes before the close
const int MARKS = 12            // 30-minute marks a full session can check at: 30, 60, ..., 360

type Moves
    array<float> values

// A session starts on its first regular-hours bar. A dataset's first bar is reported as one even when it falls inside
// a session, so it counts only when it opens with the session.
sessionStarts() =>
    session.isfirstbar_regular and (not barstate.isfirst or time == time("1D"))

// ————— History
// Band widths come from regular-session 30-minute bars. They start at the open, so their opens and their closes at the
// 30-minute marks are the 1-minute prices the rules use, and their history reaches further back than 1-minute bars.
// Each bar returns the widths the next session would use if that bar closed its session; read one bar late, a
// session's first bar gets the widths as of the previous session's close.
bandWidths(int lookback) =>
    var array<Moves> marks = array.new<Moves>()
    var array<float> todayMoves = array.new<float>(MARKS, na)
    var float dayOpen = na
    var int dayStart = na
    if barstate.isfirst
        for i = 0 to MARKS - 1
            marks.push(Moves.new(array.new<float>()))
    if sessionStarts()
        if not na(dayStart)
            for i = 0 to MARKS - 1
                float move = todayMoves.get(i)
                if not na(move)
                    array<float> values = marks.get(i).values
                    values.push(move)
                    if values.size() > lookback
                        values.shift()
        dayOpen := open
        dayStart := time("1D")
        todayMoves.fill(na)
    if not na(dayStart)
        int k = int(math.round((time_close - dayStart) / 60000.0))
        if k % CHECK_EVERY == 0 and k >= CHECK_EVERY and k <= CHECK_EVERY * MARKS
            todayMoves.set(k / CHECK_EVERY - 1, math.abs(close / dayOpen - 1.0))
    array<float> widths = array.new<float>(MARKS, na)
    for i = 0 to MARKS - 1
        array<float> values = marks.get(i).values
        float move = todayMoves.get(i)
        int fromHistory = na(move) ? lookback : lookback - 1
        if values.size() >= fromHistory
            float total = fromHistory > 0 ? values.slice(values.size() - fromHistory, values.size()).sum() : 0.0
            widths.set(i, (total + nz(move)) / lookback)
    widths[1]

// Daily returns come from daily bars, whose close is the official closing price; the last 1-minute close can differ.
// The dividend request looks ahead so that a dividend lands on its ex-date's bar instead of the next one; the amount is
// announced well before. Read one bar late, a session gets the values as of the previous session's close.
dailyHistory(int volWindow) =>
    float paid = request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_on, barmerge.lookahead_on)
    float sessionReturn = close / (close[1] - nz(paid)) - 1.0
    float sigmaD = ta.stdev(sessionReturn, volWindow, false)
    [sigmaD[1], sessionReturn[1], close[1]]

string tickerRegular = ticker.modify(syminfo.tickerid, session = session.regular)
array<float> priorWidths = request.security(tickerRegular, "30", bandWidths(lookbackInput), lookahead = barmerge.lookahead_on)
[priorSigmaD, priorReturn, priorClose] = request.security(tickerRegular, "1D", dailyHistory(volWindowInput),
     lookahead = barmerge.lookahead_on)
// The dividend going ex today, on the session's first bar.
float paid = request.dividends(syminfo.tickerid, dividends.gross, barmerge.gaps_on, barmerge.lookahead_off)

// ————— Session state
var array<float> widths = array.new<float>()
var int openTime = na
var int sessionMinutes = na
var float dayOpen = na
var float prevCloseAdj = na
var float priceVolume = 0.0
var float totalVolume = 0.0
var bool ready = false
var float leverage = na
var int shares = 0
var float priorMove = na
var int side = 0

if sessionStarts()
    if strategy.position_size != 0
        strategy.close_all(comment = "Overnight")
    openTime := time("1D")
    sessionMinutes := int(math.round((time_close("1D") - openTime) / 60000.0))
    dayOpen := open
    priceVolume := 0.0
    totalVolume := 0.0
    side := 0
    widths := priorWidths
    ready := not na(priorWidths) and not na(priorClose) and not na(priorSigmaD)
         and sessionMinutes - LAST_CHECK_GAP >= CHECK_EVERY
    if ready
        for k = CHECK_EVERY to sessionMinutes - LAST_CHECK_GAP by CHECK_EVERY
            if na(widths.get(k / CHECK_EVERY - 1))
                ready := false
    if ready
        // The chart's first bar repeats the last dividend before it.
        prevCloseAdj := priorClose - (barstate.isfirst ? 0.0 : nz(paid))
        leverage := priorSigmaD > 0.0 ? math.min(maxLeverageInput, targetVolInput / priorSigmaD) : maxLeverageInput
        shares := int(math.floor(strategy.equity * leverage / dayOpen))
        priorMove := priorSigmaD > 0.0 ? priorReturn / priorSigmaD : 0.0

// ————— Checks and exit
float upperBound = na
float lowerBound = na
float sessionVwap = na
if not na(openTime)
    int k = int(math.round((time_close - openTime) / 60000.0))
    if volume > 0
        priceVolume += hlc3 * volume
        totalVolume += volume
    sessionVwap := totalVolume > 0.0 ? priceVolume / totalVolume : close
    if ready
        int nextCheck = math.max(CHECK_EVERY, k + (CHECK_EVERY - k % CHECK_EVERY) % CHECK_EVERY)
        if nextCheck <= sessionMinutes - LAST_CHECK_GAP
            float width = widths.get(nextCheck / CHECK_EVERY - 1)
            upperBound := math.max(dayOpen, prevCloseAdj) * (1.0 + bandMultInput * width)
            lowerBound := math.min(dayOpen, prevCloseAdj) * (1.0 - bandMultInput * width)
            if k == nextCheck
                int wanted = close > math.max(upperBound, sessionVwap) ? 1 : close < math.min(lowerBound, sessionVwap) ? -1 : 0
                bool blocked = priorMoveFilterInput and wanted != 0 and wanted != side and wanted * priorMove >= priorMoveMaxInput
                int target = blocked ? 0 : wanted
                if target != side
                    if target == 0
                        strategy.close_all(comment = blocked ? "Blocked" : "Flat")
                    else if target == 1
                        strategy.entry("Long", strategy.long, qty = shares)
                    else
                        strategy.entry("Short", strategy.short, qty = shares)
                    side := target
        else if k == sessionMinutes - 1 and side != 0
            strategy.close_all(comment = "End of day")
            side := 0

// ————— Visuals
// The bounds shown on each bar are the ones its session's next check compares against.
plot(upperBound, "Upper Bound", color = color.green, style = plot.style_linebr)
plot(lowerBound, "Lower Bound", color = color.red, style = plot.style_linebr)
plot(sessionVwap, "VWAP", color = color.orange, style = plot.style_linebr)
